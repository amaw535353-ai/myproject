FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS builder
RUN apk add --no-cache build-base
COPY deploy/p11e/fixture.c /src/fixture.c
RUN cc -static -Os -s -o /fixture /src/fixture.c

FROM scratch
LABEL org.opencontainers.image.title="AegisDesk P11-E benign admission fixture"
LABEL org.opencontainers.image.description="Non-production fixture for local supply-chain mechanism validation"
COPY --from=builder /fixture /fixture
USER 10001:10001
ENTRYPOINT ["/fixture"]
